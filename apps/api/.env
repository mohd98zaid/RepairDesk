# ============================================================
# RepairDesk API — Environment Variables
# Copy to .env and fill in real values.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://repairdesk_user:change_me_in_prod@postgres:5432/repairdesk

# --- Security ---
JWT_SECRET=your-256-bit-secret-change-this-now
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=repairdesk_access
MINIO_SECRET_KEY=change_me_in_prod
MINIO_BUCKET=repairdesk
MINIO_USE_SSL=false

# --- Email (SMTP for invites + password reset + OTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=repairdesk.otp@gmail.com
SMTP_PASSWORD=wfhwqrpqmlbgpxci
FROM_EMAIL=repairdesk.otp@gmail.com

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- App ---
APP_URL=https://app.repairdesk.app
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# --- Super Admin ---
ADMIN_EMAIL=admin@repairdesk.app
ADMIN_PASSWORD=Admin@RepairDesk2024!
